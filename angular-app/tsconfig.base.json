{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@beers/shared/util": ["libs/shared/util/src/index.ts"],
      "@beers/shared/data-access": ["libs/shared/data-access/src/index.ts"],
      "@beers/metadata/data-access": ["libs/metadata/data-access/src/index.ts"],
      "@beers/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@beers/shared/ui-daisy-demo": ["libs/shared/ui-daisy-demo/src/index.ts"],
      "@beers/shared/app-layout": ["libs/shared/app-layout/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}

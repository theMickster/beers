{
  "name": "beers-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "bw",
  "sourceRoot": "apps/beers-web/src",
  "tags": ["type:feature", "scope:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/beers-web",
        "browser": "apps/beers-web/src/main.ts",
        "tsConfig": "apps/beers-web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/beers-web/public"
          }
        ],
        "styles": ["node_modules/@fortawesome/fontawesome-free/css/all.css", "apps/beers-web/src/styles.css"],
        "server": "apps/beers-web/src/main.server.ts",
        "ssr": {
          "entry": "apps/beers-web/src/server.ts"
        },
        "outputMode": "server",
        "security": {
          "allowedHosts": ["localhost", "127.0.0.1"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "define": {
            "ENABLE_SAMPLES": "false"
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "define": {
            "ENABLE_SAMPLES": "true"
          }
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "beers-web:build:production"
        },
        "development": {
          "buildTarget": "beers-web:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "beers-web:build",
        "staticFilePath": "dist/apps/beers-web/browser",
        "spa": true
      }
    }
  }
}

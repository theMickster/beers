{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "westus3"
    },
    "cosmosAccountName": {
      "value": "mickcosmos"
    },
    "cosmosDatabaseName": {
      "value": "PlatformDatabases"
    },
    "containers": {
      "value": [
        {
          "id": "Beers-Dev",
          "indexingPolicy": {
            "indexingMode": "consistent",
            "automatic": true,
            "includedPaths": [
              {
                "path": "/*"
              }
            ],
            "excludedPaths": [
              {
                "path": "/\"_etag\"/?"
              }
            ],
            "compositeIndexes": [
              [
                {
                  "path": "/Rating/reviews",
                  "order": "ascending"
                },
                {
                  "path": "/Name",
                  "order": "ascending"
                }
              ],
              [
                {
                  "path": "/CreatedDate",
                  "order": "ascending"
                },
                {
                  "path": "/Name",
                  "order": "ascending"
                }
              ]
            ]
          }
        },
        {
          "id": "Beers-QA",
          "indexingPolicy": {
            "indexingMode": "consistent",
            "automatic": true,
            "includedPaths": [
              {
                "path": "/*"
              }
            ],
            "excludedPaths": [
              {
                "path": "/\"_etag\"/?"
              }
            ],
            "compositeIndexes": [
              [
                {
                  "path": "/Rating/reviews",
                  "order": "ascending"
                },
                {
                  "path": "/Name",
                  "order": "ascending"
                }
              ],
              [
                {
                  "path": "/CreatedDate",
                  "order": "ascending"
                },
                {
                  "path": "/Name",
                  "order": "ascending"
                }
              ]
            ]
          }
        }
      ]
    }
  }
}
    {
      "name": "Beers",
      "item": [
        {
          "name": "Discover - No Filters",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has results and the four facet lists\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"results\").that.is.an(\"array\");",
                  "    pm.expect(jsonData).to.have.property(\"totalRecords\");",
                  "    pm.expect(jsonData.facets).to.have.property(\"styleFacets\").that.is.an(\"array\");",
                  "    pm.expect(jsonData.facets).to.have.property(\"categoryFacets\").that.is.an(\"array\");",
                  "    pm.expect(jsonData.facets).to.have.property(\"brewerFacets\").that.is.an(\"array\");",
                  "    pm.expect(jsonData.facets).to.have.property(\"beerTypeFacets\").that.is.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Facets are ordered by count descending\", function () {",
                  "    var facets = pm.response.json().facets;",
                  "    Object.keys(facets).forEach(function (key) {",
                  "        for (var i = 1; i < facets[key].length; i++) {",
                  "            pm.expect(facets[key][i - 1].count).to.be.at.least(facets[key][i].count);",
                  "        }",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Brewer and beer type counts sum to totalRecords\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var sum = function (items) { return items.reduce(function (total, item) { return total + item.count; }, 0); };",
                  "    pm.expect(sum(jsonData.facets.brewerFacets)).to.eql(jsonData.totalRecords);",
                  "    pm.expect(sum(jsonData.facets.beerTypeFacets)).to.eql(jsonData.totalRecords);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/beers/discover?PageNumber=1&PageSize=10&SortOrder=Ascending&OrderBy=Name",
